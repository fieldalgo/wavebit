{
  "_comment": [
    "Reviewed license inventory for every Python distribution that may be installed in a",
    "Wavebit validation, documentation or packaging environment. tools/check_licenses.py",
    "compares installed metadata against it. Add a reviewed entry before adding a dependency;",
    "a missing entry fails the check. Human-readable table: docs/development/third-party.md.",
    "external_tools and bundled are not installed by pip; the check requires the docs to list them."
  ],
  "policy": {
    "permissive": [
      "0BSD",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "BSL-1.0",
      "CC0-1.0",
      "ISC",
      "MIT",
      "MIT-0",
      "MIT-CMU",
      "PSF-2.0",
      "Python-2.0",
      "Unlicense",
      "Zlib",
      "LicenseRef-Matplotlib",
      "LicenseRef-Public-Domain"
    ],
    "weak_copyleft": [
      "LGPL-2.1-only",
      "LGPL-2.1-or-later",
      "LGPL-3.0-only",
      "LGPL-3.0-or-later",
      "MPL-2.0"
    ],
    "test_extras": [],
    "never": [
      "SSPL-1.0",
      "EUPL-1.0",
      "EUPL-1.1",
      "EUPL-1.2",
      "OSL-1.0",
      "OSL-1.1",
      "OSL-2.0",
      "OSL-2.1",
      "OSL-3.0",
      "CPAL-1.0",
      "RPL-1.1",
      "RPL-1.5"
    ],
    "shipped_never": [
      "AGPL-1.0-only",
      "AGPL-1.0-or-later",
      "AGPL-3.0-only",
      "AGPL-3.0-or-later"
    ],
    "rules": [
      "runtime (base requirements of wavebit, transitively): permissive only",
      "optional (wavebit extras): permissive, or weak copyleft when the entry sets weak_copyleft_review (unmodified, installed separately by pip, never bundled or loaded directly)",
      "tool (installed but not required: test runners, CI tools, external_tools a test environment installs): any license but never, GPL and AGPL included, since tools never ship; each still needs a reviewed entry, and an AGPL one an agpl_review note (unmodified upstream release, unshipped use only, never in a hosted service)",
      "GPL: never imported, linked or bundled by src/wavebit and never a requirement; unshipped tests, studies and reference scripts may run GPL tools, skipping when they are absent",
      "never (SSPL and other non-AGPL network copyleft): rejected in every environment; shipped_never (AGPL): rejected for runtime, optional and external-process use, accepted for tools"
    ]
  },
  "first_party": [
    "wavebit"
  ],
  "first_party_license": "Apache-2.0 AND MIT",
  "external_tools": {
    "Meep": {
      "spdx": "GPL-2.0-or-later",
      "url": "https://github.com/NanoComp/meep",
      "use": "FDTD reference solver run in its own interpreter; frozen numbers in tests/references/",
      "forbidden_imports": [
        "meep"
      ]
    },
    "S4": {
      "spdx": "GPL-2.0-or-later",
      "url": "https://github.com/victorliu/S4",
      "use": "RCWA reference solver run in its own interpreter; frozen numbers in tests/references/",
      "forbidden_imports": [
        "S4"
      ]
    },
    "Octave": {
      "spdx": "GPL-3.0-or-later",
      "url": "https://octave.org",
      "use": "runs RETICOLO as a separate process driven by oct2py",
      "forbidden_imports": []
    },
    "RETICOLO": {
      "spdx": "CC-BY-4.0",
      "url": "https://doi.org/10.5281/zenodo.14631951",
      "use": "RCWA reference run inside Octave; not shipped",
      "forbidden_imports": []
    },
    "oct2py": {
      "spdx": "MIT",
      "url": "https://github.com/blink1073/oct2py",
      "use": "Python driver for Octave in the RETICOLO comparisons",
      "forbidden_imports": []
    },
    "fmmax": {
      "spdx": "MIT",
      "url": "https://github.com/facebookresearch/fmmax",
      "use": "RCWA reference in a separate environment",
      "forbidden_imports": [
        "fmmax"
      ]
    },
    "FDTDX": {
      "spdx": "MIT",
      "url": "https://github.com/ymahlau/fdtdx",
      "use": "FDTD reference in a separate environment",
      "forbidden_imports": [
        "fdtdx"
      ]
    },
    "PyMoosh": {
      "spdx": "MIT",
      "url": "https://github.com/AnMoreau/PyMoosh",
      "use": "multilayer reference in a throwaway environment",
      "forbidden_imports": [
        "PyMoosh"
      ]
    },
    "NGSolve": {
      "spdx": "LGPL-2.1-only",
      "url": "https://github.com/NGSolve/ngsolve",
      "use": "optional FEM reference for NVF research studies; installed binaries also contain GPL-2.0-or-later UMFPACK code, so the environment is never redistributed",
      "forbidden_imports": [
        "ngsolve",
        "netgen"
      ]
    },
    "inkstone": {
      "spdx": "AGPL-3.0-or-later",
      "url": "https://github.com/alexysong/inkstone",
      "use": "black-box RCWA comparison (0.3.15, public API and returned numbers only, source never read); results cited in tests/references/README.md and docs/theory/rcwa/. No harness in this repository today",
      "agpl_review": "unmodified upstream release from PyPI; may run only in unshipped tests or studies that skip without it; never imported by src/wavebit, never a requirement or extra, never in a hosted service",
      "forbidden_imports": [
        "inkstone"
      ]
    },
    "EMpy": {
      "spdx": "MIT",
      "url": "https://github.com/lbolla/EMpy",
      "use": "past black-box comparison (ElectroMagneticPython 2.2.3) of anisotropic transfer matrices; results cited in tests/references/README.md and docs/theory/rcwa/",
      "forbidden_imports": [
        "EMpy"
      ]
    }
  },

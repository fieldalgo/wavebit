# scratch: the real directory is a sibling of the checkout; this is a symlink.
# No trailing slash -- a trailing slash matches directories, not symlinks.
lab

# The built documentation site. `sphinx-build` regenerates it from `docs/`, so it is a
# derived artifact and not a record of anything.
docs/_build/

# Jupyter autosave copies, written next to a notebook whenever it is opened in Jupyter.
.ipynb_checkpoints/

# Crash dumps an MSYS or Cygwin program (Git Bash's grep, for one) writes into the current
# directory when it faults.
*.stackdump

# Local build, profiling and comparison outputs.
artifacts/
.venv/

# Compiled optional documentation translation catalogs.
docs/locales/**/*.mo

# Repository validation caches and local example renderings.
